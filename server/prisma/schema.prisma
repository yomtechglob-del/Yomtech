datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("SUPER_ADMIN")
  createdAt    DateTime @default(now())
}

model Lead {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String?
  inquiryType String     
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}